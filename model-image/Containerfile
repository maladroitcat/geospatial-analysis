# OCI packaging for the CPL coverage model.
#
# KServe serves this two different ways depending on cluster version. On
# Kubernetes 1.33+ the kubelet mounts the image directly as a read-only image
# volume and nothing inside it ever runs. On older clusters it falls back to
# "modelcar", which runs this image as a sidecar and executes `ln` and `sleep`
# to share the filesystem. ubi-micro covers both -- a scratch base would be
# smaller but breaks the modelcar path with no useful error.
#
# The path must be /models. KServe presents it to the runtime at /mnt/models.
FROM registry.access.redhat.com/ubi9/ubi-micro:latest

RUN mkdir /models && chmod 775 /models
COPY model.json /models/

# Reference data for the MCP server: tract centroids/areas/population and the
# current coverage scores, precomputed from S3 at build time. KServe mounts
# this image with subPath "models", so nothing here is visible to the model
# server -- it only ever sees /models/model.json. Shipping both together keeps
# the model and the data it was trained against on one version tag.
RUN mkdir /data && chmod 775 /data
COPY data/ /data/
